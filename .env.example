# Copy to .env and replace all change-me values. Never commit .env.
# Single quotes preserve literal $ and # characters in Compose environment files.
DJANGO_SECRET_KEY='change-me-generate-a-long-random-secret'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=studysmart
POSTGRES_USER=studysmart
POSTGRES_PASSWORD='change-me-database-password'
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD='change-me-pgadmin-password'
DOCKER_SUBNET=172.30.50.0/24
